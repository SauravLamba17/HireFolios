# Copy to .env.production on the office PC and fill in. Never commit .env.production.
# Every docker command uses it:  docker compose --env-file .env.production <command>
#
# Make a random value (PowerShell), once for each secret below:
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); -join ($b | % { $_.ToString('x2') })

# The address staff type in the browser (no https://, no slash)
APP_DOMAIN=simplen.hirefolios.in

# Database password (letters and digits only: it goes inside a URL)
POSTGRES_PASSWORD=

# Sign-in secret, 32+ random characters. Changing it later signs everyone out.
BETTER_AUTH_SECRET=

# Other addresses allowed to sign in, comma-separated (usually empty)
BETTER_AUTH_TRUSTED_ORIGINS=

# First admin, created on first start only if this email does not exist yet.
# At least 8 characters. Change the password after the first sign-in, then you may blank it here.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin

# Folder on this PC for candidate photos and CVs (create it first)
UPLOAD_HOST_DIR=C:\hirefolios-data\uploads

# HTTPS: Caddyfile.cloudflare (option A, Let's Encrypt) or Caddyfile.internal (option B)
CADDYFILE=Caddyfile.internal

# Option A only: Cloudflare API token with Zone.DNS edit permission for hirefolios.in
CLOUDFLARE_API_TOKEN=
