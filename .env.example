# Copy to .env and fill in. Never commit .env. Every machine-specific value lives here (or in the
# environment); the server checks them at start-up (src/lib/config.ts) and stops with a message that names
# the variable if one is missing or wrong. On the office PC, install.ps1 writes C:\hirefolios\.env itself.

# --- Required -----------------------------------------------------------------------------------------------
# Database. Dev: the permanent local PostgreSQL 16 set up by scripts/dev-postgres.ps1 (it fills this in).
DATABASE_URL=postgres://hirefolios_dev:password@localhost:5432/hirefolios_dev

# 32+ random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Address staff type in the browser (public URL of this server), no path, no trailing slash.
BETTER_AUTH_URL=http://localhost:3000

# Folder for candidate photos, CVs and the company logo (STORAGE_DRIVER=local, the office PC). ABSOLUTE path, outside
# public/ and not inside .next/ (the production server runs from .next/standalone, which a build wipes).
# Windows example: C:\hirefolios-data\uploads
UPLOAD_DIR=

# --- Optional (defaults shown) ------------------------------------------------------------------------------
# Other addresses allowed to sign in, comma-separated (e.g. the LAN address other PCs use: http://192.168.1.20:3000)
BETTER_AUTH_TRUSTED_ORIGINS=
# Port and address the server listens on (Next.js reads them; install.ps1 sets 127.0.0.1 behind Caddy)
PORT=3000
HOSTNAME=
# Backups folder (used by the backup scripts; checked here when set) and the file holding the last backup time
BACKUP_DIR=
BACKUP_STATUS_FILE=
# How long a sign-in lasts: staff (hours, 1-24) and the lobby TV display account (days, 1-90)
STAFF_SESSION_HOURS=12
DISPLAY_SESSION_DAYS=30
# Intake upload limits: each CV file (MB, 1-25), CV files per candidate (1-10), webcam CV pages (1-20)
MAX_UPLOAD_MB=8
MAX_CV_FILES=5
MAX_CV_PAGES=10
# Deletion job (retention): on/off, how often (minutes, 5-1440), and office hours it waits outside of (India
# time, e.g. 09:00-19:00; empty = any time)
PURGE_JOB=on
PURGE_INTERVAL_MINUTES=30
OFFICE_HOURS=
# Start-up: apply migrations (1) from MIGRATIONS_DIR (absolute; default ./drizzle), run the seed (1)
RUN_MIGRATIONS=0
MIGRATIONS_DIR=
SEED_ON_START=0
# Version shown on the status card (the release sets it)
APP_VERSION=

# --- AWS / internet-facing (Phase 5; docs/DEPLOY-AWS.md, deploy/docker/env.aws.example) ---------------------
# File storage: local (UPLOAD_DIR) or s3. S3 credentials come from the AWS SDK's usual places (an IAM role, or
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in this file on a Lightsail server); the app never prints them.
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=ap-south-1
# Only for an S3-compatible test server (e.g. http://127.0.0.1:7070 with S3_FORCE_PATH_STYLE=1); empty on AWS
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=0
# Server-side encryption: AES256 (SSE-S3), aws:kms or none
S3_SSE=AES256
# on: file links answer with a signed S3 URL that expires after S3_SIGNED_URL_SECONDS (10-900); off: the app streams
S3_SIGNED_URLS=off
S3_SIGNED_URL_SECONDS=60
# Managed PostgreSQL: TLS (disable | require | verify-full with the provider's CA bundle) and pool size (1-50)
DB_SSL=disable
DB_SSL_CA_FILE=
DB_POOL_MAX=10
# Nightly encrypted database backup to its own bucket (32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"   — keep a copy offline!)
BACKUP_BUCKET=
BACKUP_ENCRYPTION_KEY=
BACKUP_TIME=02:30
PG_DUMP_PATH=
PG_RESTORE_PATH=
# Roles that must use two-factor sign-in (authenticator app), e.g. admin,hr. Empty: optional for everyone.
TWO_FACTOR_REQUIRED_ROLES=
# Sign-in attempts per internet address (count/seconds); account lock after N wrong passwords for M minutes;
# API requests per signed-in person per minute
SIGN_IN_LIMIT=20/60
LOCKOUT_ATTEMPTS=5
LOCKOUT_MINUTES=15
API_RATE_LIMIT_PER_MINUTE=600
# Emergency switch: 1 ignores the office IP allow-list (Settings → Security) if an admin locked everyone out
IP_ALLOWLIST_OFF=0
# Server log lines: text (office PC) or json (AWS / CloudWatch)
LOG_FORMAT=text

# --- Development only ---------------------------------------------------------------------------------------
# First admin, created by `npm run db:seed` only if that email does not exist yet (8+ character password).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin
# Written by scripts/dev-postgres.ps1: the local PostgreSQL superuser password (never used by the app).
DEV_PG_SUPERUSER_PASSWORD=
# npm run demo:seed: the demo admin's sign-in (a separate "demo" tenant with sample candidates)
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
# Playwright: use an installed browser instead of downloading one (chrome | msedge)
PW_CHANNEL=
