# Copy to .env and fill in. Never commit .env.

# Dev database from docker-compose.dev.yml
DATABASE_URL=postgres://app:app@localhost:5432/app

# 32+ random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Address staff type in the browser (the office PC on the LAN), no trailing slash
BETTER_AUTH_URL=http://localhost:3000

# Other addresses allowed to sign in, comma-separated
# (e.g. the office PC's LAN address used by the other PCs: http://192.168.1.20:3000)
BETTER_AUTH_TRUSTED_ORIGINS=

# First admin, created by `npm run db:seed` only if that email does not exist yet.
# Password: at least 8 characters. Change it after first sign-in.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin

# Folder for candidate photos and CV files. Must be an ABSOLUTE path, outside public/ and
# not inside .next/ (the production server runs from .next/standalone, which a build wipes).
# Windows example: C:\hirefolios-data\uploads   Docker example: /data/uploads
UPLOAD_DIR=

# Playwright: use an installed browser instead of downloading one (chrome | msedge)
PW_CHANNEL=
