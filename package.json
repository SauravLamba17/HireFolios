{
  "name": "walkin-recruitment",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node --env-file-if-exists=.env .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --conditions=react-server --env-file-if-exists=.env src/db/seed.ts",
    "postbuild": "node -e \"const fs=require('fs'),d=process.env.NEXT_DIST_DIR||'.next';fs.cpSync(d+'/static',d+'/standalone/'+d+'/static',{recursive:true});if(fs.existsSync('public'))fs.cpSync('public',d+'/standalone/public',{recursive:true})\" && node scripts/build-tools.mjs",
    "dev:check": "node scripts/dev-check.mjs",
    "smoke": "tsx --conditions=react-server --env-file-if-exists=.env scripts/smoke.ts",
    "package": "node scripts/package.mjs",
    "db:check": "tsx --env-file-if-exists=.env scripts/db-check.ts",
    "demo:seed": "tsx --conditions=react-server --env-file-if-exists=.env scripts/demo-seed.ts",
    "demo:clear": "tsx --conditions=react-server --env-file-if-exists=.env scripts/demo-seed.ts --clear",
    "lint:ps": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/lint-ps.ps1",
    "files:to-s3": "tsx --conditions=react-server --env-file-if-exists=.env scripts/migrate-files-to-s3.ts",
    "backup:s3": "tsx --conditions=react-server --env-file-if-exists=.env scripts/backup-s3.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "better-auth": "^1.7.19",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "next": "15.5.29",
    "postgres": "^4.1.0",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
