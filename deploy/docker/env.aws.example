# Hirefolios on AWS — the settings file for docker-compose.aws.yml (docs/DEPLOY-AWS.md).
# Copy to /opt/hirefolios/hirefolios.env on the server, fill in, then: chmod 600 hirefolios.env
# Never commit the filled-in file, never put it in the image. (Option: keep the secrets in AWS SSM Parameter Store and
# write this file from there at boot — docs/DEPLOY-AWS.md section 11.)
# The server checks every value at start-up and stops with a message naming any variable that is missing or wrong.

# --- Public address -----------------------------------------------------------------------------------------
BETTER_AUTH_URL=https://simplen.hirefolios.in
# 32+ random characters, unique to this server (NOT the office PC's or SESS's):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# --- Managed PostgreSQL 16 (Lightsail database or RDS; Hirefolios' own, never shared with SESS) -------------
# Use the "endpoint" from the console; the password must be URL-encoded if it has special characters.
DATABASE_URL=postgres://hirefolios:PASSWORD@ENDPOINT:5432/hirefolios
DB_SSL=verify-full
# The AWS RDS CA bundle (also used by Lightsail databases), mounted read-only into the container:
#   curl -o /opt/hirefolios/rds-ca.pem https://truststore.pki.rds.amazonaws.com/ap-south-1/ap-south-1-bundle.pem
DB_SSL_CA_FILE=/app/certs/rds-ca.pem
DB_POOL_MAX=10
RUN_MIGRATIONS=1
SEED_ON_START=1
# first admin, created once on the first start (then remove the password line from this file)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin

# --- S3 (two buckets in ap-south-1, Block Public Access on, encryption on) ----------------------------------
STORAGE_DRIVER=s3
S3_BUCKET=hirefolios-simplen-uploads
S3_REGION=ap-south-1
S3_SSE=AES256
S3_SIGNED_URLS=off
S3_SIGNED_URL_SECONDS=60
# Lightsail instances cannot take an IAM role: use the access key of the IAM user "hirefolios-app" (policy in
# docs/DEPLOY-AWS.md). On EC2, leave these two empty and attach the role "hirefolios-app" to the instance instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# --- Backups ---------------------------------------------------------------------------------------------------
BACKUP_BUCKET=hirefolios-simplen-backups
# 32 random bytes in base64 — keep a copy OFFLINE (printed and sealed, or a password manager): without it no backup
# can be restored.   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BACKUP_ENCRYPTION_KEY=
BACKUP_TIME=02:30

# --- Internet-facing security ---------------------------------------------------------------------------------
TWO_FACTOR_REQUIRED_ROLES=admin,hr
SIGN_IN_LIMIT=20/60
LOCKOUT_ATTEMPTS=5
LOCKOUT_MINUTES=15
API_RATE_LIMIT_PER_MINUTE=600
IP_ALLOWLIST_OFF=0
STAFF_SESSION_HOURS=12
DISPLAY_SESSION_DAYS=30

# --- Housekeeping ------------------------------------------------------------------------------------------------
PURGE_JOB=on
OFFICE_HOURS=09:00-19:00
LOG_FORMAT=json
APP_VERSION=
